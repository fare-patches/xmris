# Cross-build the game and its private static SDL using LLVM-MinGW.
ARCH ?= aarch64
TARGET = $(ARCH)-w64-mingw32
OUT = build/windows-$(ARCH)
SDL_DIR ?= build/SDL3-3.4.20
.PHONY: all
all: bitmaps/sprites
	cmake -S windows -B $(OUT) -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_SYSTEM_PROCESSOR=$(ARCH) \
	  -DCMAKE_C_COMPILER=$(TARGET)-clang -DCMAKE_CXX_COMPILER=$(TARGET)-clang++ \
	  -DCMAKE_RC_COMPILER=$(TARGET)-windres -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_C_FLAGS="-ffunction-sections -fdata-sections" -DSDL_SOURCE="$(abspath $(SDL_DIR))" \
	  -DSDL_STATIC=ON -DSDL_SHARED=OFF -DSDL_TEST_LIBRARY=OFF
	cmake --build $(OUT) --target xmris

bitmaps/sprites: scram.c ansiknr.h Makefile.std $(wildcard bitmaps/*/*.rgb bitmaps/*/*.bw)
	$(MAKE) -f Makefile.sdl bitmaps/sprites CC=cc
