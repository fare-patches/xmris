! These are some of the resources you can fiddle with for xmris
! The defaults are shown in the man page.

*Up:			apostrophe
*Down:			slash
*Left:			z
*Right:			x
*Throw:			space
*Pause:			p
*Quit:			q
*Iconize:		i
*Keyboard:		k
*Dir:			SCORE
*ReverseVideo:		no
*Monochrome:		no
*Gender:		he
*Random:		no
*Busywait:		no
*UserName:		no
*Font:			FONT
*Static:		no

! The resources for xmred
! These are overly specific, so you can alter individual ones easily
*mred*TransientShell.allowShellResize:yes
*mred*TransientShell*Text.useStringInPlace:no
*mred*TransientShell.dialog*resize:yes
*mred*load*dialog*Text*editType:textAppend
*mred*comment*dialog*Text.baseTranslations:#override
*mred*comment*dialog*Text.Translations:#override
*mred*load*dialog*Text.baseTranslations:#override\
<Key>Return:\n
*mred*load*dialog*Text.Translations:#override\
<Key>Return:\n
*mred*TransientShell*dialog.Text.baseTranslations:#override\
<Key>Return:set-dialog-button(agree)\n\
Ctrl<Key>g:set-dialog-button(disagree)\n\
<Key>Escape:set-dialog-button(disagree)\n
*mred*TransientShell*dialog.Text.Translations:#override\
<Key>Return:set-dialog-button(agree)\n\
Ctrl<Key>g:set-dialog-button(disagree)\n\
<Key>Escape:set-dialog-button(disagree)\n
*mred*dialog*ok.label:Ok
*mred*dialog*continue.label:Continue
*mred*dialog*retry.label:Retry
*mred*dialog*cancel.label:Cancel
*mred*dialog*clear.label:Clear
*mred*dialog*abort.label:Abort
*mred*dialog*default.label:Default
*mred*altered.title:Altered
*mred*showGrip:no
*mred.defaultDistance:0
