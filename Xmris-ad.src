! These are the color names for xmris.
! You can have sub resources mris, msit, mris.swap, msit.swap.
! The * resource separator is probably useful. RTFM if you're
! confused.

! Colour resources
!*Visual:			pseudocolor
!*Distinct:		255
!*Private:			no
!*Depth:			8

! *{mris,msit}.{swap}.<name>:<color>
*mred*AppleFaint:           #CCCCCC
*mred*swap.AppleFaint:      #FFFFFF
*GreenBack:                 #77BB77
*swap.GreenBack:            #BBFFBB
*GreenFore:                 #007700
*swap.GreenFore:            #00BB00
*RedBack:                   #BB7777
*swap.RedBack:              #FFBBBB
*RedFore:                   #770000
*swap.RedFore:              #BB0000
*BlueBack:                  #7777BB
*swap.BlueBack:             #BBBBFF
*BlueFore:                  #000077
*swap.BlueFore:             #0000BB
*mris.DroneBack:            #AA3333
*mris.swap.DroneBack:       #FF6666
*mris.DroneFore:            #992222
*mris.swap.DroneFore:       #FF2222
*Background:                #FFFFFF
*swap.Background:           #000000
*Foreground:                #000000
*swap.Foreground:           #FFFFFF
*BorderColor:               #000000
*swap.BorderColor:          #FFFFFF
*mris*Ball:                 #FFFF77
*msit*Ball:                 #FF00FF
*Cherry:                    #EE0000
*swap.CherryStalk:          #EEAA66
*Apple1:                    #EEDD00
*Apple2:                    #DD3300
*AppleFaint:                #BBBBBB
*Gem1:                      #DDDDDD
*Gem2:                      #BBBBBB
*LetterGot:                 #000000
*swap.LetterGot:            #FFFFFF
*LetterNotGot:              #BBBBBB
*Normal:                    #EE0000
*Munch1:                    #FFFF00
*mris*Munch2:               #CCCCCC
*msit*Munch2:               #FFFF00
*mris.Drone:                #0000DD
*mris.swap.Drone:           #6666FF
*msit*Drone:                #00FF00
*msit*DroneTongue:          #EE0000
*Extra:                     #EEFF00
*mris.Player:               #0000DD
*Player:                    #6666FF
*PlayerBobble:              #FFFFFF
*PlayerSkin:                #FFCCCC
*swap.PlayerSkin:           #FFDDDD
*msit.swap.PlayerBoot:      #DD9955
*mris.swap.PlayerBoot:      #EEAA66
*msit.PlayerBoot:           #773322
*mris*Chomp:                #FFFFFF
*msit*Chomp:                #CCFF00
*mris*ChompLip:             #77FFFF
*msit*ChompTongue:          #EE0000
*Seat:                      #EE0000
*Cake:                      #FFFF77
