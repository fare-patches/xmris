makemred.o : defmred.h defcom.h makecom.c Icon.h PixmapList.h

$(SCRAMOBJS) : ansiknr.h

Drag.o : Drag.h

Icon.o : Drag.h Icon.h

PixmapList.o : PixmapList.h Drag.h

# dependencies for single files
# can't use $(@:.o=.c) or similar clever thing, 'cos its incompatible
# gnumake is clever enough to perform a check out using implicit rules

apple.o : apple.c

