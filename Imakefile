/* Imake compatibility */
#ifndef MakeDir
#define MakeDir(dir)	mkdir dir
#endif

#ifndef InstallManPageAliases
#define InstallManPageAliases(name,dir,target) \
install.man :: @@\
	ln -s ./name.$(MANSUFFIX) $(DESTDIR)dir/target.$(MANSUFFIX) @@
#endif

