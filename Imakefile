XCOMM using alltarget can cause gnumake to try and make a target called all.
XCOMM the reason is the All Target macro has no rules, so gnumake tries
XCOMM to find an implicit one. Other makes just give up.
all :: initialize
	@#keep gnumake happy

all :: xmris xmred
	@#keep gnumake happy

all :: README.xmris README.xmred Xmris.ad Xmsit.ad
	@#keep gnumake happy

XCOMM rules to make sure the initialize thing is done
clean :: initialize
	@#keep gnumake happy

install :: initialize
	@#keep gnumake happy

XCOMM xmris build
NormalProgramTarget(xmris,$(MRISOBJS),$(DEPLIBS),-lSDL2 -lXrender $(LOCAL_LIBRARIES),)


InstallProgramWithFlags(xmris,$(THEBINDIR),$(INSTMRISFLAGS))

install :: $(DESTDIR)$(THEBINDIR)/xmris
	$(RM) $(DESTDIR)$(THEBINDIR)/xmsit
	$(LN) xmris $(DESTDIR)$(THEBINDIR)/xmsit

XCOMM xmred build
NormalProgramTarget(xmred,$(MREDOBJS) $(WIDGETOBJS),$(DEPLIBS),$(LOCAL_LIBRARIES) -lm,)

InstallProgram(xmred,$(THEBINDIR))

XCOMM manual pages
README.xmris : xmris.man
	$(RM) README.xmris
	nroff -rLL=65n -man xmris.man > README.xmris

README.xmred : xmred.man
	$(RM) README.xmred
	nroff -rLL=65n -man xmred.man > README.xmred

InstallManPage(xmris,$(THEMANDIR))

InstallManPageAliases(xmris,$(THEMANDIR),xmsit)

InstallManPage(xmred,$(THEMANDIR))

XCOMM application resource files
InstallAppDefaults(Xmris)
InstallAppDefaults(Xmsit)

Xmris.ad : Xmris-ad.src
	sed -e s@FONT@$(FONT)@ < Xmris-ad.src > Xmris.ad

Xmsit.ad : Xmris.ad
	sed -e "s@Gender:\t\the@Gender:\t\tshe@" < Xmris.ad > Xmsit.ad

#ifdef InstallDefaultGardens
XCOMM install default gardens
install :: $(GARDENS)
	MakeDir(InstallDefaultGardens)
	@set dummy $(GARDENS) ; shift ; \
	while [ $$# != 0 ] ; \
	do \
	  (set -x ; $(INSTALL) -c $(INSTAPPFLAGS) $$1 InstallDefaultGardens/$$1) ; \
	  shift ; \
	done
#endif /* InstallDefaultGardens */

XCOMM scram program
NormalProgramTarget(scram,$(SCRAMOBJS),,,)

clean ::
	$(RM) $(MRISOBJS)
	$(RM) Xmris.ad
	$(RM) Xmsit.ad
	$(RM) $(MREDOBJS)
	$(RM) $(WIDGETOBJS)
	$(RM) $(SCRAMOBJS)

tar : $(ALLFILES) README.xmris README.xmred Makefile.std
	@set -e; archive=$(APP).$(VERSION).tgz; tmp=`mktemp "$$archive.XXXXXX"`; \
	trap 'rm -f "$$tmp"' EXIT; \
	tar czf "$$tmp" --transform='s,^,$(APP).$(VERSION)/,' \
	    README.xmris README.xmred Makefile.std $(ALLFILES); \
	chmod 644 "$$tmp"; mv -f "$$tmp" "$$archive"

XCOMM these are the o dependencies
sound.o : music-score.h
